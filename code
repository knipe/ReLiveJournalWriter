<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Private Journal Writer</title>
<style>:root{--pink:#ff5b80;--red:#ff003b;--pale:#ffc5d1}*{box-sizing:border-box}body{margin:0;padding:16px;background:#fff1f5;color:#7d0020;font:16px Arial,sans-serif}.wrap{max-width:760px;margin:auto}.card{background:white;border:3px solid var(--red);margin:0 0 16px}.head{background:var(--red);color:white;padding:12px;font-weight:bold}.body{padding:14px}label{display:block;font-weight:bold;margin:12px 0 5px}input,textarea{width:100%;font:16px Arial;padding:10px;border:1px solid #d88;border-radius:4px}textarea{min-height:180px;resize:vertical}.buttons{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}button{background:var(--red);color:white;border:0;padding:12px 15px;font-weight:bold;border-radius:4px;font-size:15px}button.secondary{background:#ffc5d1;color:#79001e}.entry{border-top:1px solid #f3a0b1;padding:12px 0}.small{font-size:13px;color:#765}.notice{background:#fff4d8;padding:10px;border-left:4px solid #d99b20;line-height:1.4}.entry-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:8px}</style></head>
<body><main class="wrap">
<section class="card"><div class="head">paperflowersx10 · private journal writer</div><div class="body">
<p>Write privately here, then download the homepage, calendar and individual entry pages to upload to Neocities.</p>
<div class="notice"><strong>Important:</strong> Keep this writer private. Do not upload it to your public Journal folder. Your entries are saved in this browser on this device. Download JSON backups regularly.</div>
<label for="date">Date</label><input id="date" type="date"><label for="time">Time</label><input id="time" type="time"><label for="mood">Mood (optional)</label><input id="mood" placeholder="e.g. thoughtful ☁️"><label for="music">Music (optional)</label><input id="music" placeholder="e.g. Artist — Song"><label for="entry">Your entry</label><textarea id="entry" placeholder="What happened today?"></textarea>
<div class="buttons"><button id="save">Save entry</button><button class="secondary" id="home">Download homepage (index.html)</button><button class="secondary" id="calendar">Download calendar.html</button></div><p class="small" id="status" aria-live="polite"></p></div></section>
<section class="card"><div class="head">Saved entries on this device</div><div class="body"><div id="entries"></div><div class="buttons"><button class="secondary" id="backup">Download entries backup (.json)</button><button class="secondary" id="restoreBtn">Restore backup</button><input id="restore" type="file" accept="application/json" hidden></div><p class="small">Each entry gets its own permanent page, named entry-YYYY-MM-DD.html. Upload the homepage and each new or changed entry page to your Journal folder. Upload the calendar again when you add entries on a new date.</p></div></section>
</main>
<script>
const KEY='paperflowersx10_entries_v1';let entries=[];try{entries=JSON.parse(localStorage.getItem(KEY)||'null')||[]}catch(e){entries=[]}
const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function persist(){localStorage.setItem(KEY,JSON.stringify(entries));render()}
function filename(e){return 'entry-'+e.date+'.html'}
function dateLabel(e){return new Date(e.date+'T12:00:00').toLocaleDateString('en-GB',{day:'2-digit',month:'long',year:'numeric'})}
function entryHtml(e){const paras=esc(e.body).split(/\n\s*\n/).map(p=>'<p>'+p.replace(/\n/g,'<br>')+'</p>').join('');const meta=[e.mood?'<p><strong>Mood:</strong> '+esc(e.mood)+'</p>':'',e.music?'<p><strong>Music:</strong> '+esc(e.music)+'</p>':''].join('');return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(dateLabel(e))} · paperflowersx10</title><style>body{margin:0;padding:12px;background:#ff5b80;color:#ff003b;font:16px Arial,sans-serif}.journal{max-width:760px;margin:auto}.bar{background:#ff003b;color:white;padding:10px;font-weight:bold}.bar a{color:white}.entry{background:white;border:4px solid #ff003b;margin-top:12px}.body{padding:14px;line-height:1.5}.body p{margin:0 0 14px}.foot{text-align:right;padding:9px;border-top:1px solid #ff9bad}.foot a{color:#ff003b;margin-left:12px}</style></head><body><main class="journal"><div class="bar"><a href="index.html">paperflowersx10's Journal</a> · ${esc(dateLabel(e))}</div><article class="entry"><div class="bar">🔒 [${esc(dateLabel(e))}] [${esc(e.time||'')}]</div><div class="body">${meta}${paras}</div><div class="foot"><a href="profile.html">userinfo</a><a href="calendar.html">calendar</a><a href="index.html">back to journal</a></div></article></main></body></html>`}
function homeHtml(){const sorted=[...entries].sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time));const cards=sorted.map(e=>`<article class="entry"><header class="entry-head"><span>🔒</span><time>[${esc(dateLabel(e))}] [${esc(e.time||'')}]</time></header><div class="entry-body">${e.mood?'<p>Mood: '+esc(e.mood)+'</p>':''}${e.music?'<p>Music: '+esc(e.music)+'</p>':''}<p>${esc(e.body).split(/\n\s*\n/)[0].replace(/\n/g,'<br>')}${e.body.length>180?'…':''}</p><p><a href="${filename(e)}">[read full entry]</a></p></div><div class="entry-foot"><a href="profile.html">userinfo</a><a href="calendar.html">calendar</a></div></article>`).join('');return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>paperflowersx10's Journal</title><style>body{margin:0;padding:12px;background:#ff5b80;color:#ff003b;font:16px Arial,sans-serif}.journal{max-width:760px;margin:auto}.topbar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;background:#ff003b;color:white;padding:10px;font-weight:bold}.topbar a{color:white;text-decoration:none}.profile{background:#ffc5d1;border:4px solid #ff003b;text-align:center;padding:15px;margin:10px 0 20px}.profile a{color:#ff003b}.entry{margin:0 0 18px;border:4px solid #ff003b;background:white}.entry-head{display:flex;justify-content:space-between;gap:10px;padding:9px;background:#ff003b;color:white}.entry-body{padding:12px;line-height:1.45}.entry-body p{margin:0 0 12px}.entry-body a,.entry-foot a{color:#ff003b}.entry-foot{text-align:right;border-top:1px solid #ff9bad;padding:8px}.entry-foot a{margin-left:12px}@media(max-width:600px){body{padding:8px}}</style></head><body><main class="journal"><nav class="topbar"><span>paperflowersx10's Journal</span><span><a href="profile.html">[userinfo]</a> · <a href="calendar.html">[calendar]</a></span></nav><section class="profile"><strong>paperflowersx10</strong><br><a href="profile.html">[userinfo|about me]</a> · <a href="calendar.html">[calendar|monthly view]</a></section>${cards||'<p>No entries yet.</p>'}</main></body></html>`}
function calendarHtml(){const groups={};entries.forEach(e=>(groups[e.date]??=[]).push(e));const dates=Object.keys(groups).sort();const month=dates.length?dates[dates.length-1].slice(0,7):new Date().toISOString().slice(0,7);const [y,m]=month.split('-').map(Number);const first=new Date(y,m-1,1),days=new Date(y,m,0).getDate(),offset=(first.getDay()+6)%7;let cells='';for(let i=0;i<offset;i++)cells+='<td></td>';for(let d=1;d<=days;d++){const key=`${y}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}`;cells+=`<td>${groups[key]?`<a href="${filename(groups[key][0])}">${d}</a>`:d}</td>`;if((offset+d)%7===0)cells+='</tr><tr>';}return `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Calendar · paperflowersx10</title><style>body{margin:0;padding:12px;background:#ff5b80;color:#ff003b;font:16px Arial,sans-serif}.wrap{max-width:650px;margin:auto}.bar{background:#ff003b;color:white;padding:10px;font-weight:bold}.bar a{color:white}.panel{background:white;border:4px solid #ff003b;padding:12px}table{width:100%;border-collapse:collapse;text-align:center}th,td{padding:12px 4px;border:1px solid #f5a0b3}a{color:#ff003b;font-weight:bold}</style></head><body><main class="wrap"><div class="bar"><a href="index.html">paperflowersx10's Journal</a> · Calendar</div><section class="panel"><h2>${new Date(y,m-1,1).toLocaleDateString('en-GB',{month:'long',year:'numeric'})}</h2><table><tr>${['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(x=>'<th>'+x+'</th>').join('')}</tr><tr>${cells}</tr></table><p><a href="index.html">Back to journal</a> · <a href="profile.html">userinfo</a></p></section></main></body></html>`}
function download(name,content){const a=document.createElement('a');const url=URL.createObjectURL(new Blob([content],{type:'text/html'}));a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1200)}
function render(){$('entries').innerHTML=entries.length?[...entries].sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time)).map(e=>`<div class="entry"><strong>${esc(e.date)} ${esc(e.time)}</strong><div>${esc(e.body).slice(0,140)}${e.body.length>140?'…':''}</div><div class="entry-actions"><button class="secondary" onclick="editEntry('${esc(e.id)}')">Edit</button><button class="secondary" onclick="deleteEntry('${esc(e.id)}')">Delete</button><button class="secondary" onclick="downloadEntry('${esc(e.id)}')">Download entry page</button></div></div>`).join(''):'No entries saved yet.'}
window.editEntry=id=>{const e=entries.find(x=>x.id===id);if(!e)return;$('date').value=e.date;$('time').value=e.time;$('mood').value=e.mood;$('music').value=e.music;$('entry').value=e.body;$('status').textContent='Editing this entry. Save to update it.';window.scrollTo(0,0)};
window.deleteEntry=id=>{if(confirm('Delete this entry from this device?')){entries=entries.filter(x=>x.id!==id);persist()}};
window.downloadEntry=id=>{const e=entries.find(x=>x.id===id);if(e)download(filename(e),entryHtml(e))};
$('date').value=new Date().toISOString().slice(0,10);$('time').value=new Date().toTimeString().slice(0,5);
$('save').onclick=()=>{const date=$('date').value,time=$('time').value,body=$('entry').value.trim();if(!date||!body){alert('Please add a date and write something first.');return}const id=date+'T'+time;const item={id,date,time,mood:$('mood').value.trim(),music:$('music').value.trim(),body};const i=entries.findIndex(x=>x.id===id);if(i>=0)entries[i]=item;else entries.push(item);persist();$('entry').value='';$('mood').value='';$('music').value='';$('status').textContent='Saved on this device. Download the homepage, calendar and this entry page to publish.'};
$('home').onclick=()=>download('index.html',homeHtml());$('calendar').onclick=()=>download('calendar.html',calendarHtml());$('backup').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(entries,null,2)],{type:'application/json'}));a.download='paperflowersx10-backup.json';a.click()};$('restoreBtn').onclick=()=>$('restore').click();$('restore').onchange=async ev=>{try{const data=JSON.parse(await ev.target.files[0].text());if(!Array.isArray(data))throw 0;entries=data;persist();$('status').textContent='Backup restored.'}catch(e){alert('Could not read that backup.')}ev.target.value=''};render();
</script></body></html>
